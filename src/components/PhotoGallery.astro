---
interface Props {
	photos: string[];
	folder: string;
}
const { photos, folder } = Astro.props;
---

<div class="gallery">
	{photos.map((photo) => (
		<a href={`/photos/${folder}/${photo}`} target="_blank" class="gallery-item">
			<img
				src={`/photos/${folder}/${photo}`}
				alt="活动照片"
				loading="lazy"
			/>
		</a>
	))}
</div>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 10px;
		margin-top: 1.5em;
	}
	.gallery-item {
		display: block;
		overflow: hidden;
		border-radius: 8px;
		aspect-ratio: 4/3;
		background: #e2e8f0;
	}
	.gallery-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 8px;
		transition: transform 0.2s ease, opacity 0.2s;
		display: block;
	}
	.gallery-item:hover img {
		transform: scale(1.03);
		opacity: 0.92;
	}
</style>
